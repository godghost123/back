<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArrayBackup</RootNamespace>
    <AssemblyName>ArrayBackup</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- wwwroot wird vom Web-SDK automatisch als Content eingebunden;
       beim Publizieren landet es neben der DLL, im Dev-Fallbackpfad
       in Program.cs direkt im Projektverzeichnis. -->

</Project>
