  function T(key) { return (STRINGS[LANG] && STRINGS[LANG][key]) || STRINGS.de[key] || key; }
  function applyI18n() {
    document.querySelectorAll('[data-i18n]').forEach(function (el) {
      el.textContent = T(el.getAttribute('data-i18n'));
    });
    // icons stay outside the text so the table can be reused for any language
    $('ab-start').textContent = '\u25B6 ' + T('btn_start');
    $('ab-stop').textContent = '\u25A0 ' + T('btn_stop');
  }

  function $(id) { return document.getElementById(id); }
  function api(action, params, method) {
    method = method || 'POST';
    // csrf_token muss in jedem POST stecken, sonst meldet emhttp
    // "missing csrf_token" im syslog. Der beim Seiten-Render gesetzte Token
    // ist massgeblich - ajax.php prueft deshalb selbst nicht (var.ini auf
    // Disk kann davon abweichen und liefert falsche "abgelaufen"-Meldungen).
    var body = new URLSearchParams(Object.assign({action: action, csrf_token: CSRF}, params || {}));
    var opt = {method: method, headers: {'Content-Type': 'application/x-www-form-urlencoded'}};
    if (method === 'GET') { body.append('_', Date.now()); }
    var url = API + (method === 'GET' ? '?' + body.toString() : '');
    if (method !== 'GET') opt.body = body.toString();
    return fetch(url, opt).then(function (r) { return r.json(); });
  }
  function banner(msg, cls) {
    var b = $('ab-banner');
    if (!msg) { b.className = 'ab-banner'; b.textContent = ''; }
    else { b.className = 'ab-banner ' + cls; b.textContent = msg; }
  }
  function fmtBytes(n) {
    if (n === null || n === undefined) return '';
    var u = ['B','KB','MB','GB','TB','PB'], i = 0;
    while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
    return (i === 0 ? n : n.toFixed(1)) + ' ' + u[i];
  }
  function fmtDur(s) {
    if (!s) return '';
    var h = Math.floor(s/3600), m = Math.floor((s%3600)/60);
    return (h ? h + 'h ' : '') + m + 'm';
  }
  function chip(state, cls) { return '<span class="ab-chip ' + (cls || state) + '">' + state + '</span>'; }

  /* ---------- Tabs ---------- */
  document.querySelectorAll('.ab-tab').forEach(function (t) {
    t.addEventListener('click', function () {
      document.querySelectorAll('.ab-tab').forEach(function (x) { x.classList.remove('active'); });
      document.querySelectorAll('.ab-panel').forEach(function (x) { x.classList.remove('active'); });
      t.classList.add('active');
      $('ab-panel-' + t.dataset.tab).classList.add('active');
      if (t.dataset.tab === 'browser') loadRunOptions();
    });
  });

  /* ---------- Status / Live ---------- */
  function pollStatus() {
    api('status', {}, 'GET').catch(function () { return {}; }).then(function (res) {
      if (!res.ok) return;
      var s = res.status || {};
      var running = !!s.engine_running;
      var live = $('ab-live');
      if (running) {
        live.style.display = 'block';
        $('ab-live-id').textContent = s.run_id || '';
        // Engine phase (engine.sh RUN_PHASE): setup = before/starting the
        // rsync jobs, transfer = copying, finalize = du + sweep + promotion
        // (all transfers over, nothing is read anymore - without this the
        // UI looks "stuck" although the run is healthy). Older engines
        // without the phase key simply show the plain "running" text.
        var phase = s.phase || 'transfer';
        var phaseTxt = phase === 'setup' ? T('phase_setup')
                     : phase === 'finalize' ? T('phase_finalize') : '';
        $('ab-global').textContent = T('global_running') + (s.dry_run ? ' ' + T('dry_run_tag') : '') +
          (s.elapsed ? ' (' + fmtDur(s.elapsed) + ')' : '');
        var pc = loadProgressCache();
        if (pc.run !== s.run_id) pc = {run: s.run_id, src: {}};
        pc.src = pc.src || {};
        var srcs = s.sources || s.disks || {};
        var bars = '';
        Object.keys(srcs).forEach(function (d) {
          var info = srcs[d] || {};
          var pct = parseFloat(info.pct) || 0;
          // exit may arrive as number or string (older engines quoted it);
          // normalize before comparing - a string "0" must never render as
          // "fehlgeschlagen (exit 0)".
          var ex = null;
          if (info.exit !== undefined && info.exit !== null && info.exit !== '') {
            ex = parseInt(info.exit, 10);
            if (isNaN(ex)) ex = null;
          }
          if (pct > 0 || info.rate || info.eta) {
            // keep the newest non-empty values; a poll that momentarily
            // parses nothing must never blank the bar
            pc.src[d] = {pct: pct || (pc.src[d] && pc.src[d].pct) || 0,
                         rate: info.rate || (pc.src[d] && pc.src[d].rate) || '',
                         eta: info.eta || (pc.src[d] && pc.src[d].eta) || ''};
          }
          var last = pc.src[d] || {pct: pct, rate: '', eta: ''};
          var label;
          if (info.done || ex === 0 || ex === 24) {
            label = esc(d) + ' &nbsp; \u2713 ' + esc(T('src_done'));
            pct = 100;
          } else if (ex !== null) {
            label = esc(d) + ' &nbsp; \u2717 ' + esc(T('src_failed')) + ' (exit ' + ex + ')';
          } else if (pct >= 100) {
            label = esc(d) + ' &nbsp; \u2713 ' + esc(T('src_done'));
          } else if (!last.pct && !last.rate && !last.eta) {
            // job queued (max_jobs) or still scanning: say so instead of
            // rendering an empty bar that reads as "broken"
            label = esc(d) + ' &nbsp; ' + esc(T('src_pending'));
          } else {
            label = esc(d) + ' &nbsp; ' + (last.pct || '') + (last.pct ? '%' : '') +
                    ' &nbsp; ' + esc(last.rate || '') + ' &nbsp; ETA ' + esc(last.eta || '-');
          }
          bars += '<div class="ab-bar"><div style="width:' + Math.min(100, pct) + '%"></div><span>' + label + '</span></div>';
        });
        if (phaseTxt) bars += '<div class="ab-muted" style="margin-top:6px">' + esc(phaseTxt) + '</div>';
        if (!bars) bars = '<div class="ab-muted">' + esc(T('loading')) + '</div>';
        $('ab-live-bars').innerHTML = bars;
        saveProgressCache(pc);
      } else {
        live.style.display = 'none';
        $('ab-global').textContent = s.state ? T('last_run') + ' ' + (s.run_id || '') + ': ' + s.state : '';
        if (lastRunning) clearProgressCache();
        // Fehlergrund aus status.json (engine.sh schreibt dorthin die Ursache)
        if (s.error && (s.state === 'failed' || s.state === 'partial')) {
          banner(T('error_prefix') + ' ' + (s.run_id || '') + ' (' + s.state + '): ' + s.error +
                 ' ' + T('error_details'), 'err');
        } else if (s.orphan) {
          // Orphan-Warning (Kap. 4.8: warning only, the content is NOT secured)
          banner(T('orphan_info') + ' ' + (Array.isArray(s.orphan) ? s.orphan.join(', ') : s.orphan), 'info');
        }
      }
      if (lastRunning && !running) { loadRuns(); } // Lauf beendet -> Tabellen neu laden
      lastRunning = running;
    });
  }

  /* ---------- Runs table ---------- */
  function loadRuns() {
    api('runs', {}, 'GET').then(function (res) {
      if (!res.ok) { banner(T('target_unreach') + ' ' + (res.error || ''), 'err'); return; }
      banner('', '');
      runsCache = res.runs || [];
      var tb = $('ab-runs').querySelector('tbody');
      tb.innerHTML = '';
      if (!runsCache.length) {
        tb.innerHTML = '<tr><td colspan="7" class="ab-muted">' + esc(T('no_runs')) + '</td></tr>';
        return;
      }
      runsCache.forEach(function (r) {
        var m = r.meta || {};
        var srcs = m.sources || m.disks || {};
        var disks = Object.keys(srcs).map(function (d) {
          var ok = (srcs[d].exit === 0 || srcs[d].exit === 24);
          return '<span title="' + d + '">' + (ok ? '&#9679;' : '&#10007;') + '</span>';
        }).join(' ');
        var dur = '';
        if (m.started && m.finished) {
          dur = fmtDur((new Date(m.finished.replace(' ', 'T')) - new Date(m.started.replace(' ', 'T'))) / 1000);
        }
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td class="ab-mono">' + r.id + (r.is_latest ? ' <b title="latest">&#9733;</b>' : '') + '</td>' +
          '<td>' + chip(m.state || '?', m.state === 'aborted' ? 'aborted-old' : m.state) + '</td>' +
          '<td>' + disks + '</td>' +
          '<td>' + fmtBytes(m.total_logical_bytes) + '</td>' +
          '<td>' + fmtBytes(m.total_delta_bytes) + '</td>' +
          '<td>' + dur + '</td>' +
          '<td>' +
            '<button class="ab-btn small ghost" data-act="pin" data-run="' + r.id + '">' + (r.pinned ? '&#128293; ' + esc(T('unpin')) : '&#128204; ' + esc(T('pin'))) + '</button>' +
            '<button class="ab-btn small warn" data-act="del" data-run="' + r.id + '">' + esc(T('del_run')) + '</button>' +
          '</td>';
        tb.appendChild(tr);
      });
      tb.querySelectorAll('button').forEach(function (b) {
        b.addEventListener('click', function () {
          var run = b.dataset.run;
          if (b.dataset.act === 'pin') {
            api('pin', {run: run}).then(loadRuns);
          } else if (confirm(T('confirm_del').replace('{run}', run))) {
            api('delete-run', {run: run}).then(function (r2) {
              if (!r2.ok) banner(r2.error, 'err');
              loadRuns();
            });
          }
        });
      });
    });
  }

  /* ---------- Start / Stop ---------- */
  $('ab-start').addEventListener('click', function () {
    banner('', '');
    api('start').then(function (res) {
      if (!res.ok) banner(res.error, 'err');
      else { lastRunning = true; pollStatus(); }
    });
  });
  $('ab-stop').addEventListener('click', function () {
    api('stop').then(function (res) { if (!res.ok) banner(res.error, 'err'); });
  });

  /* ---------- Array-Browser (Komplettsicht) ---------- */
  // Directories with 100k+ entries used to be fetched whole (multi-MB JSON,
  // frozen tab). The API now pages (offset/limit/truncated); we page here too.
  var PAGE = 500;
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function browseState(tblId, crumbId, path) {
    return { tbl: $(tblId), crumbs: $(crumbId), path: path, entries: [], done: 0, total: 0, truncated: false };
  }
  var view1 = browseState('ab-browse1', 'ab-crumb1', '');

  function loadMore(view) {
    api('ls', { path: view.path, offset: view.done, limit: PAGE }, 'GET').then(function (res) {
      if (!res.ok) {
        view.tbl.querySelector('tbody').innerHTML = '<tr><td colspan="4" class="ab-muted">' + esc(res.error || '') + '</td></tr>';
        return;
      }
      view.entries = view.entries.concat(res.entries || []);
      view.done = res.offset + (res.count || 0);
      view.total = res.total;
      view.truncated = !!res.truncated;
      renderBrowse(view, function (name) {
        browse1(view.path ? view.path + '/' + name : name);
      });
    });
  }
  function crumbs(el, path, cb) {
    var parts = path.split('/').filter(Boolean), acc = [], html = '';
    html += '<a data-p="">' + esc(T('root')) + '</a>';
    parts.forEach(function (p) { acc.push(p); html += ' / <a data-p="' + esc(acc.join('/')) + '">' + esc(p) + '</a>'; });
    el.innerHTML = html;
    el.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { cb(a.dataset.p); });
    });
  }
  function renderBrowse(view, onDir) {
    var tb = view.tbl.querySelector('tbody');
    tb.innerHTML = '';
    view.entries.forEach(function (e) {
      var tr = document.createElement('tr');
      tr.innerHTML = '<td>' + (e.dir ? '&#128193; <a href="#" class="ab-dir">' + esc(e.name) + '/</a>' : '&#128196; ' + esc(e.name)) + '</td>' +
                     '<td>' + (e.dir ? '' : fmtBytes(e.size)) + '</td>' +
                     '<td>' + new Date(e.mtime * 1000).toLocaleString() + '</td>' +
                     '<td><button class="ab-btn small ghost ab-restore-btn">' + esc(T('restore_btn')) + '</button></td>';
      if (e.dir) tr.querySelector('.ab-dir').addEventListener('click', function (ev) { ev.preventDefault(); onDir(e.name); });
      tr.querySelector('.ab-restore-btn').addEventListener('click', function () { openRestore(view, e); });
      tb.appendChild(tr);
    });
    if (view.truncated) {
      var tr = document.createElement('tr');
      tr.innerHTML = '<td colspan="4"><button class="ab-btn small ghost">' + esc(T('load_more')) + ' (' +
                     (view.done) + ' / ' + view.total + ')</button></td>';
      tr.querySelector('button').addEventListener('click', function () { loadMore(view); });
      tb.appendChild(tr);
    } else if (view.total > 0) {
      var tr2 = document.createElement('tr');
      tr2.innerHTML = '<td colspan="4" class="ab-muted">' + view.total + ' ' + esc(T('entries')) + '</td>';
      tb.appendChild(tr2);
    }
  }
  function resetAndLoad(view, path, browseFn) {
    view.path = path;
    view.entries = []; view.done = 0; view.total = 0; view.truncated = false;
    view.tbl.querySelector('tbody').innerHTML = '<tr><td colspan="4" class="ab-muted">' + esc(T('loading')) + '</td></tr>';
    crumbs(view.crumbs, path, browseFn);
    loadMore(view);
  }
  function loadRunOptions() {
    api('runs', {}, 'GET').then(function (res) {
      if (!res.ok) return;
      var sel = $('ab-run-select');
      sel.innerHTML = '';
      (res.runs || []).forEach(function (r) {
        // merged fs/ layout: the content root of new runs is runs/<id>/fs.
        // New meta has a "sources" map and NO "disks" map at all; legacy meta
        // has "disks". Healed meta carries both (and "healed":true) - it is
        // a run of the OLD layout, so it must keep the disk root.
        var m = r.meta || {};
        var hasDiskMap = m.disks && Object.keys(m.disks).length > 0;
        var isMerged = m.sources && !m.healed && !hasDiskMap;
        var o = document.createElement('option');
        o.value = 'runs/' + r.id + (isMerged ? '/fs' : '');
        o.textContent = r.id + ' (' + (m.state || '?') + ')' + (isMerged ? ' fs' : ' old');
        sel.appendChild(o);
      });
      resetAndLoad(view1, sel.value || '', browse1);
    });
  }
  $('ab-run-select').addEventListener('change', function () { resetAndLoad(view1, this.value, browse1); });
  function browse1(path) { resetAndLoad(view1, path, browse1); }

  /* ---------- Restore (asynchron, Backend: restore.sh) ---------- */
  // ajax.php fuehrt restore.sh per nohup aus; hier wird nur alle 2 s
  // restore.json gezeichnet. Guard gegen Gleichzeitigkeit (Backup laeuft)
  // trifft das Server-Ende - die UI zeigt dann einfach die Fehlermeldung.
  var restoreTimer = null, restoreLastKey = '';
  function currentRunId(path) {
    var m = /^runs\/(r-\d{8}-\d{6})(\/|$)/.exec(path || '');
    return m ? m[1] : '';
  }
  function shareOfPath(p) {
    var m = /^runs\/r-\d{8}-\d{6}\/fs\/([^/]+)/.exec(p || '');
    return m ? m[1] : '';
  }
  function openRestore(view, entry) {
    var src = view.path ? view.path + '/' + entry.name : entry.name;
    if (!currentRunId(src)) { banner(T('restore_no_run'), 'err'); return; }
    banner('', '');
    $('rs-src').textContent = src;
    $('rs-msg').textContent = '';
    $('rs-target-custom').value = '';
    var sel = $('rs-target-select');
    sel.innerHTML = '';
    var oc = document.createElement('option');
    oc.value = '__custom__'; oc.textContent = T('rs_custom');
    sel.appendChild(oc);
    // Ziel-Vorschlag: Original-Share unter /mnt/user (Top-Level-Verzeichnis
    // des Snapshot-Pfads). Die Liste stammt aus shares-list (direkt aus
    // runs/<id>/fs gelesen, die pershare/-Symlink-Ansicht ist entfallen).
    var want = '/mnt/user/' + shareOfPath(src);
    api('shares-list', {run: currentRunId(src)}).then(function (res) {
      var found = false;
      ((res.ok && res.entries) || []).forEach(function (e) {
        var o = document.createElement('option');
        o.value = '/mnt/user/' + e.name;
        o.textContent = o.value;
        sel.appendChild(o);
        if (o.value === want) found = true;
      });
      sel.value = found ? want : '__custom__';
      toggleCustomTarget();
    });
    $('ab-restore-dialog').style.display = 'block';
  }
  function toggleCustomTarget() {
    $('rs-target-custom').style.display = $('rs-target-select').value === '__custom__' ? 'block' : 'none';
  }
  $('rs-target-select').addEventListener('change', toggleCustomTarget);
  $('rs-cancel').addEventListener('click', function () { $('ab-restore-dialog').style.display = 'none'; });
  $('rs-start').addEventListener('click', function () {
    var sel = $('rs-target-select');
    var dest = sel.value === '__custom__' ? $('rs-target-custom').value.trim() : sel.value;
    var src = $('rs-src').textContent;
    var mode = $('rs-mode-skip').checked ? 'skip' : 'overwrite';
    api('restore-start', {run: currentRunId(src), src: src, dest: dest, mode: mode}).then(function (res) {
      if (!res.ok) { $('rs-msg').textContent = T('error_colon') + ' ' + res.error; return; }
      $('ab-restore-dialog').style.display = 'none';
      restoreLastKey = '';
      startRestorePoll();
      pollRestore();
    });
  });
  $('ab-restore-stop').addEventListener('click', function () {
    api('restore-stop').then(function (res) { if (!res.ok) banner(res.error, 'err'); });
  });
  function startRestorePoll() { if (!restoreTimer) restoreTimer = setInterval(pollRestore, 2000); }
  function stopRestorePoll() { if (restoreTimer) { clearInterval(restoreTimer); restoreTimer = null; } }
  function pollRestore() {
    api('restore-status', {}, 'GET').then(function (res) {
      if (!res.ok) return;
      var r = res.restore || {};
      var card = $('ab-restore-card');
      var st = r.state || '';
      if (st === 'running') {
        card.style.display = 'block';
        startRestorePoll();
        var p = r.progress || {};
        var pct = parseFloat(p.pct) || 0;
        $('ab-restore-bar').style.width = Math.min(100, pct) + '%';
        $('ab-restore-pct').textContent =
          (pct ? pct + '%' : '') + (p.rate ? '  ' + p.rate : '') +
          (p.eta ? '  ETA ' + p.eta : '') + (r.elapsed ? '  (' + fmtDur(r.elapsed) + ')' : '');
        $('ab-restore-label').textContent =
          (r.run_id || '') + ' \u00B7 ' + (r.label || '') + ' ' + T('restore_to') + ' ' + (r.dest || '');
      } else if (st) {
        card.style.display = 'none';
        stopRestorePoll();
        // Abschluss-Meldung genau EINMAL pro beendetem Restore (Kennung aus
        // state+updated+dest) - ein Reload darf denselben Banner nicht ewig
        // wiederkauen lassen.
        var key = st + '|' + (r.updated || '') + '|' + (r.dest || '');
        if (key !== restoreLastKey) {
          restoreLastKey = key;
          var label = ' ' + (r.label || '') + ' ' + T('restore_to') + ' ' + (r.dest || '');
          if (st === 'success') banner(T('restore_done') + label, 'info');
          else {
            var pre = st === 'aborted' ? T('restore_aborted')
                    : st === 'lost' ? T('restore_lost') : T('restore_failed');
            banner(pre + label + (r.error ? ' (' + r.error + ')' : ''), 'err');
          }
        }
      } else {
        card.style.display = 'none';
        stopRestorePoll();
      }
    });
  }

  /* ---------- Config ---------- */
  function loadConfig() {
    api('config-get', {}, 'GET').then(function (res) {
      if (!res.ok) return;
      var c = res.config;
      $('cfg-target').value = c.target;
      $('cfg-retention').value = c.retention_runs;
      $('cfg-minfree').value = c.retention_min_free_gb;
      $('cfg-maxjobs').value = c.max_jobs;
      $('cfg-bwlimit').value = c.bwlimit_kbps;
      $('cfg-dryrun').checked = !!c.dry_run;
      $('cfg-resume').checked = c.resume_aborted !== false;
      $('cfg-excludes').value = c.excludes || '';
      $('cfg-sched-en').checked = !!c.schedule_enabled;
      $('cfg-sched-cron').value = c.schedule_cron;
      $('cfg-backup-pools').checked = c.backup_pools !== false;
      $('cfg-pool-filter').value = c.pool_filter || '';
      $('cfg-skip-shares').value = c.skip_shares || '';
    });
  }
  $('ab-save').addEventListener('click', function () {
    api('config-save', {
      target: $('cfg-target').value,
      retention_runs: $('cfg-retention').value,
      retention_min_free_gb: $('cfg-minfree').value,
      max_jobs: $('cfg-maxjobs').value,
      bwlimit_kbps: $('cfg-bwlimit').value,
      dry_run: $('cfg-dryrun').checked ? 1 : 0,
      resume_aborted: $('cfg-resume').checked ? 1 : 0,
      excludes: $('cfg-excludes').value,
      schedule_enabled: $('cfg-sched-en').checked ? 1 : 0,
      schedule_cron: $('cfg-sched-cron').value,
      backup_pools: $('cfg-backup-pools').checked ? 1 : 0,
      pool_filter: $('cfg-pool-filter').value,
      skip_shares: $('cfg-skip-shares').value
    }).then(function (res) {
      $('ab-save-msg').textContent = res.ok ? T('saved') : (T('error_colon') + ' ' + res.error);
    });
  });

  /* ---------- init ---------- */
  applyI18n();
  loadConfig();
  loadRuns();
  pollStatus();
  pollTimer = setInterval(pollStatus, 2000);
  // a restore that is still running (or ended while the page was closed)
  // surfaces its card/banner right away
  pollRestore();
})();
</script>
